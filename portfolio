<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#050507" />
<meta name="description" content="Karthick — first-year ECE student, vibe coder, and builder of interactive web experiences, AI tools and hardware prototypes." />
<title>Karthick — ECE Student &amp; Vibe Coder</title>

<!--
==========================================================================
  KARTHICK — SINGLE-FILE INTERACTIVE PORTFOLIO
==========================================================================
  EDIT ZONES (search these labels):
   [EDIT 1] PROJECTS array in <script>  -> fan cards + split showcase
   [EDIT 2] METRICS array in <script>   -> animated counters
   [EDIT 3] CONTACT block in HTML       -> email + social links
   [EDIT 4] INTRO / HERO copy in HTML   -> all headlines and labels
   [EDIT 5] CSS :root variables         -> colors, accent, fonts
  Replace any `--art:` gradient with `url('images/your-image.jpg')`.
==========================================================================
-->

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

<style>
/* ==========================================================================
   [EDIT 5] DESIGN TOKENS
   ========================================================================== */
:root{
  --bg:#050507;
  --bg-soft:#0b0b0e;
  --panel:#0e0e13;
  --line:rgba(255,255,255,.10);
  --line-strong:rgba(212,175,107,.38);
  --text:#f5f3ee;
  --muted:#8d8d97;
  --accent:#d4af6a;
  --accent-hi:#f3dfb4;
  --accent-dim:rgba(212,175,107,.10);
  --display:"Bebas Neue","Arial Narrow",sans-serif;
  --cond:"Barlow Condensed","Arial Narrow",sans-serif;
  --body:"Inter",system-ui,-apple-system,sans-serif;
  --ease:cubic-bezier(.16,1,.3,1);

  /* driven by JS during the intro zoom */
  --intro-scale:1;
  --intro-alpha:1;
  --main-scale:1.10;
  --main-alpha:0;
  --main-blur:6px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--body);
  line-height:1.6;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
body.is-locked{overflow:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
img{max-width:100%;display:block}
::selection{background:var(--accent);color:#08080a}

/* Ambient night-drive glow + film grain */
body::before{
  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse 60% 45% at 78% -8%,rgba(212,175,107,.10),transparent 60%),
    radial-gradient(ellipse 50% 40% at 4% 105%,rgba(90,105,145,.08),transparent 60%);
}
body::after{
  content:"";position:fixed;inset:0;z-index:2;pointer-events:none;opacity:.05;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
.container{width:min(100% - 72px,1320px);margin-inline:auto;position:relative;z-index:1}

/* ==========================================================================
   CUSTOM CURSOR (hidden on touch via JS class)
   ========================================================================== */
.cursor-layer{position:fixed;inset:0;z-index:9999;pointer-events:none;display:none}
body.custom-cursor .cursor-layer{display:block}
body.custom-cursor,body.custom-cursor a,body.custom-cursor button{cursor:none}
.cursor-aura,.cursor-ring,.cursor-dot{position:absolute;top:0;left:0;will-change:transform}
.cursor-aura{
  width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle,rgba(212,175,107,.16),transparent 68%);
  filter:blur(6px);
}
.cursor-ring{
  width:38px;height:38px;border-radius:50%;
  border:1px solid rgba(212,175,107,.65);
  box-shadow:0 0 18px rgba(212,175,107,.12),inset 0 0 14px rgba(212,175,107,.06);
}
.cursor-dot{width:5px;height:5px;border-radius:50%;background:var(--accent-hi);box-shadow:0 0 10px var(--accent)}
.click-ripple{position:fixed;z-index:9998;width:64px;height:64px;border:1px solid var(--accent);border-radius:50%;pointer-events:none;animation:ripple .7s var(--ease) forwards}
.scroll-progress{position:fixed;top:0;left:0;z-index:300;height:2px;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-hi));box-shadow:0 0 12px var(--accent);pointer-events:none}

/* ==========================================================================
   INTRO — layered 3D planes + zoom transition
   ========================================================================== */
.intro{
  position:fixed;inset:0;z-index:1000;overflow:hidden;
  background:radial-gradient(ellipse at 50% 42%,#111117 0%,#070709 48%,#030304 100%);
  transform:scale3d(var(--intro-scale),var(--intro-scale),1);
  opacity:var(--intro-alpha);
  transform-origin:50% 50%;
  will-change:transform,opacity;
}
.intro-scene{position:absolute;inset:0;perspective:1100px;transform-style:preserve-3d}
.intro-plane{position:absolute;inset:0;display:grid;place-items:center;will-change:transform;transform-style:preserve-3d;animation:planeIn .9s var(--ease) both}
.plane-mid{animation-delay:.12s}
.plane-front{animation-delay:.24s}

/* far plane: ghost typography + road perspective */
.plane-back .ghost-type{
  font-family:var(--display);font-size:clamp(8rem,22vw,22rem);line-height:.8;
  letter-spacing:.04em;color:transparent;
  -webkit-text-stroke:1px rgba(255,255,255,.045);
  white-space:nowrap;transform:translateZ(-160px);
}
.plane-back .road{
  position:absolute;left:-20%;right:-20%;bottom:-38%;height:92%;
  background:repeating-linear-gradient(90deg,transparent 0 6.8%,rgba(255,255,255,.045) 6.8% 6.95%),
             linear-gradient(to top,rgba(212,175,107,.06),transparent 62%);
  transform:perspective(520px) rotateX(72deg) translateZ(-120px);
  mask-image:linear-gradient(to top,black,transparent 78%);
  -webkit-mask-image:linear-gradient(to top,black,transparent 78%);
  animation:roadMove 2.2s linear infinite;
}
.plane-mid .orbit{
  width:min(62vw,620px);aspect-ratio:1;border-radius:50%;
  border:1px solid rgba(212,175,107,.16);
  box-shadow:0 0 120px rgba(212,175,107,.06) inset;
  animation:orbitSpin 26s linear infinite;
}
.plane-mid .orbit::before,.plane-mid .orbit::after{
  content:"";position:absolute;inset:12%;border-radius:50%;border:1px solid rgba(255,255,255,.06);
}
.plane-mid .orbit::after{inset:27%;border-color:rgba(212,175,107,.14)}

.plane-front{flex-direction:column;gap:0;text-align:center}
.intro-kicker{
  font-family:var(--cond);font-size:.72rem;letter-spacing:.42em;text-transform:uppercase;
  color:var(--accent);margin-bottom:14px;animation:flicker 4.6s steps(1) infinite;
}
.intro-title{
  font-family:var(--display);font-size:clamp(3.4rem,10.5vw,9rem);line-height:.82;
  letter-spacing:.05em;color:var(--text);
  text-shadow:0 20px 80px rgba(0,0,0,.8);
  animation:titlePulse 3.6s ease-in-out infinite;
}
.intro-title span{color:var(--accent)}
.intro-tag{
  font-family:var(--cond);font-size:clamp(.8rem,1.4vw,1.05rem);
  letter-spacing:.38em;text-transform:uppercase;color:var(--muted);margin-top:18px;
}
.intro-line{width:min(340px,70vw);height:1px;background:var(--line);margin:32px 0 0;overflow:hidden}
.intro-line i{display:block;height:100%;width:100%;background:linear-gradient(90deg,transparent,var(--accent),transparent);animation:sweep 2.2s var(--ease) infinite}
@keyframes sweep{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

.intro-enter{
  position:absolute;z-index:3;left:50%;bottom:clamp(60px,10vh,110px);transform:translateX(-50%);
  display:flex;align-items:center;gap:14px;
  padding:15px 28px;border:1px solid var(--line-strong);border-radius:2px;
  font-family:var(--cond);font-size:.82rem;letter-spacing:.28em;text-transform:uppercase;
  background:rgba(8,8,11,.5);backdrop-filter:blur(8px);
  transition:background .35s,color .35s,border-color .35s;
}
.intro-enter:hover{background:var(--accent);color:#08080a;border-color:var(--accent)}
.intro-enter span{font-size:1.1rem;line-height:1}
.intro-hint{
  position:absolute;z-index:3;bottom:24px;left:0;right:0;text-align:center;
  font-family:var(--cond);font-size:.62rem;letter-spacing:.34em;text-transform:uppercase;color:var(--muted);
}

/* Main stage starts pushed back, then resolves when entered */
#mainStage{
  position:relative;z-index:1;
  transform:scale3d(var(--main-scale),var(--main-scale),1);
  opacity:var(--main-alpha);
  filter:blur(var(--main-blur));
  will-change:transform,opacity;
}
body.is-entered #mainStage{transform:none;opacity:1;filter:none;will-change:auto}

/* ==========================================================================
   HEADER
   ========================================================================== */
.site-header{
  position:fixed;top:0;left:0;right:0;z-index:200;height:88px;
  display:flex;align-items:center;border-bottom:1px solid transparent;
  transition:background .4s,border-color .4s,backdrop-filter .4s;
}
.site-header.scrolled{background:rgba(5,5,7,.82);backdrop-filter:blur(18px);border-bottom-color:var(--line)}
.nav-wrap{display:flex;align-items:center;justify-content:space-between;gap:34px}
.brand{display:flex;align-items:center;gap:14px}
.brand-mark{
  font-family:var(--display);font-size:1.9rem;line-height:1;letter-spacing:.02em;color:var(--text);
}
.brand-mark i{color:var(--accent);font-style:normal}
.brand-sub{font-family:var(--cond);font-size:.58rem;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);border-left:1px solid var(--line);padding-left:14px}
.nav{display:flex;align-items:center;gap:34px}
.nav a{
  font-family:var(--cond);font-size:.72rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;
  color:var(--muted);position:relative;transition:color .25s;
}
.nav a::after{content:"";position:absolute;left:0;bottom:-7px;width:100%;height:1px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
.nav a:hover,.nav a.active{color:var(--text)}
.nav a:hover::after,.nav a.active::after{transform:scaleX(1)}
.nav-cta{display:flex;align-items:center;gap:12px}
.menu-toggle{display:none;width:42px;height:42px;border:1px solid var(--line);border-radius:50%;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.menu-toggle span{width:16px;height:1px;background:var(--text);transition:transform .3s,opacity .2s}
.menu-toggle.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.menu-toggle.open span:nth-child(2){opacity:0}
.menu-toggle.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

/* ==========================================================================
   SHARED TYPE / BUTTONS
   ========================================================================== */
.eyebrow{
  display:inline-flex;align-items:center;gap:12px;
  font-family:var(--cond);font-size:.7rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--accent);
}
.eyebrow::before{content:"";width:28px;height:1px;background:var(--accent)}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:12px;
  padding:15px 26px;border:1px solid var(--line-strong);border-radius:2px;
  font-family:var(--cond);font-size:.76rem;font-weight:600;letter-spacing:.24em;text-transform:uppercase;
  transition:background .3s,color .3s,border-color .3s;
  will-change:transform;
}
.btn:hover{border-color:var(--accent);background:var(--accent-dim)}
.btn--solid{background:var(--accent);color:#08080a;border-color:var(--accent)}
.btn--solid:hover{background:var(--accent-hi);border-color:var(--accent-hi)}
.btn span{font-size:1.05rem;line-height:1;transition:transform .3s var(--ease)}
.btn:hover span{transform:translate(4px,-4px)}
.section-head{
  position:relative;
  display:flex;align-items:end;justify-content:space-between;gap:40px;
  padding-bottom:26px;border-bottom:1px solid var(--line);margin-bottom:56px;
}
.section-head::after{content:"";position:absolute;left:0;bottom:-1px;width:100%;height:1px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform 1s var(--ease)}
.section-head.in-view::after{transform:scaleX(1)}
.section-head h2{font-family:var(--display);font-size:clamp(2.6rem,5vw,4.6rem);line-height:.9;font-weight:400;letter-spacing:.01em;text-transform:uppercase}
.section-head p{max-width:360px;color:var(--muted);font-size:.9rem}
.reveal{opacity:0;transform:translate3d(0,34px,0);transition:opacity .9s var(--ease),transform .9s var(--ease)}
.reveal.in-view{opacity:1;transform:none}

/* ==========================================================================
   HERO + FANNED CARD STACK
   ========================================================================== */
.hero{position:relative;min-height:100svh;display:flex;align-items:center;padding:150px 0 130px;overflow:hidden}
.hero-grid{
  position:absolute;inset:0;pointer-events:none;
  background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:90px 90px;
  mask-image:radial-gradient(ellipse at 62% 45%,black,transparent 72%);
  -webkit-mask-image:radial-gradient(ellipse at 62% 45%,black,transparent 72%);
  opacity:.4;
}
.hero-glow{
  position:absolute;width:760px;height:760px;border-radius:50%;right:-8%;top:2%;pointer-events:none;
  background:radial-gradient(circle,rgba(212,175,107,.12),transparent 62%);filter:blur(20px);will-change:transform;
}
.hero-streaks{
  position:absolute;inset:-20% -12%;pointer-events:none;opacity:.38;will-change:transform;
  background:repeating-linear-gradient(115deg,transparent 0 88px,rgba(212,175,107,.055) 88px 89px,transparent 89px 180px);
  animation:streakMove 9s ease-in-out infinite alternate;
}
.hero-inner{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
.hero-copy{will-change:transform}
.hero-headline{
  font-family:var(--display);font-weight:400;text-transform:uppercase;
  font-size:clamp(4.2rem,8.6vw,8.6rem);line-height:.84;letter-spacing:.005em;margin:24px 0 26px;
}
.hero-headline .line{display:block;overflow:hidden;padding-bottom:.04em}
.hero-headline .line i{display:block;font-style:normal;transform:translate3d(0,110%,0);opacity:0}
body.is-entered .hero-headline .line i{animation:lineUp .95s var(--ease) forwards}
body.is-entered .hero-headline .line:nth-child(2) i{animation-delay:.12s}
body.is-entered .hero-headline .line:nth-child(3) i{animation-delay:.24s}
.hero-headline em{
  font-style:normal;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent-hi) 35%,var(--accent) 70%);
  background-size:200% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  animation:shimmer 4.5s linear infinite;
}
.hero-lede{max-width:470px;color:var(--muted);font-size:.98rem;font-weight:300;margin-bottom:36px}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap}
.hero-foot{display:flex;align-items:center;gap:16px;margin-top:52px;font-family:var(--cond);font-size:.66rem;letter-spacing:.26em;text-transform:uppercase;color:var(--muted)}
.hero-foot i{display:block;width:74px;height:1px;background:var(--line-strong)}

/* fan */
.fan-wrap{position:relative;height:540px;perspective:1500px;will-change:transform}
.fan-glow{position:absolute;left:50%;top:50%;width:520px;height:520px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(212,175,107,.13),transparent 62%);filter:blur(24px);pointer-events:none}
.fan-stack{position:absolute;inset:0;transform-style:preserve-3d}
.fan-card{
  position:absolute;left:50%;top:50%;width:260px;height:372px;
  margin:-186px 0 0 -130px;border:1px solid rgba(255,255,255,.14);border-radius:3px;
  background:linear-gradient(155deg,rgba(255,255,255,.075),rgba(255,255,255,.012));
  box-shadow:0 34px 70px rgba(0,0,0,.6),inset 0 0 0 1px rgba(0,0,0,.25);
  overflow:hidden;transform-style:preserve-3d;will-change:transform;
  transition:border-color .3s,box-shadow .3s;
}
.fan-card:hover{border-color:var(--line-strong);box-shadow:0 44px 90px rgba(0,0,0,.7),0 0 50px rgba(212,175,107,.12)}
.fan-card__art{position:absolute;inset:0;background-image:var(--art);background-size:cover;background-position:center;opacity:.92;animation:artDrift 12s ease-in-out infinite;will-change:transform}
.fan-card::after{content:"";position:absolute;z-index:2;top:0;left:0;width:45%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.14),transparent);transform:translateX(-130%) skewX(-20deg);pointer-events:none}
.fan-card:hover::after{animation:shineSweep .9s var(--ease)}
.fan-card__art::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(5,5,7,.96) 0%,rgba(5,5,7,.35) 48%,rgba(5,5,7,.05) 100%)}
.fan-card__top{position:absolute;top:16px;left:18px;right:18px;display:flex;justify-content:space-between;font-family:var(--cond);font-size:.63rem;letter-spacing:.24em;text-transform:uppercase;color:var(--accent-hi)}
.fan-card__body{position:absolute;left:18px;right:18px;bottom:20px}
.fan-card__body small{font-family:var(--cond);font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--accent)}
.fan-card__body h2{font-family:var(--display);font-size:2.15rem;line-height:.92;font-weight:400;letter-spacing:.01em;margin:8px 0 6px;text-transform:uppercase}
.fan-card__body p{font-size:.7rem;color:var(--muted);font-family:var(--cond);letter-spacing:.14em;text-transform:uppercase}
.fan-caption{position:absolute;bottom:6px;left:0;right:0;text-align:center;font-family:var(--cond);font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted)}

.marquee{
  position:absolute;left:0;right:0;bottom:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  overflow:hidden;background:rgba(5,5,7,.5);
}
.marquee__track{display:flex;width:max-content;animation:marquee 26s linear infinite;will-change:transform}
.marquee span{
  font-family:var(--display);font-size:1.5rem;letter-spacing:.14em;text-transform:uppercase;
  padding:12px 28px;color:rgba(245,243,238,.5);white-space:nowrap;
}
.marquee span b{color:var(--accent);font-weight:400}
@keyframes marquee{to{transform:translate3d(-50%,0,0)}}
/* --- extra motion library --- */
@keyframes orbitSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
@keyframes roadMove{from{background-position:0 0,0 0}to{background-position:0 90px,0 90px}}
@keyframes titlePulse{0%,100%{text-shadow:0 20px 80px rgba(0,0,0,.8),0 0 0 rgba(212,175,107,0)}50%{text-shadow:0 20px 80px rgba(0,0,0,.8),0 0 60px rgba(212,175,107,.3)}}
@keyframes flicker{0%,19%,21%,100%{opacity:1}20%{opacity:.42}22%{opacity:.85}}
@keyframes lineUp{from{transform:translate3d(0,110%,0);opacity:0}to{transform:none;opacity:1}}
@keyframes shimmer{0%{background-position:0% 50%}100%{background-position:200% 50%}}
@keyframes shineSweep{0%{transform:translateX(-130%) skewX(-20deg)}100%{transform:translateX(230%) skewX(-20deg)}}
@keyframes artDrift{0%,100%{transform:scale(1.04) translate3d(0,0,0)}50%{transform:scale(1.12) translate3d(-2%,1.5%,0)}}
@keyframes scan{0%{transform:translateY(-130%)}100%{transform:translateY(130%)}}
@keyframes ripple{from{transform:translate(-50%,-50%) scale(.2);opacity:.85}to{transform:translate(-50%,-50%) scale(1);opacity:0}}
@keyframes streakMove{from{transform:translate3d(-7%,0,0)}to{transform:translate3d(7%,0,0)}}
@keyframes lineDraw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes numGlow{0%,100%{text-shadow:none}50%{text-shadow:0 0 34px rgba(212,175,107,.5)}}
@keyframes planeIn{from{opacity:0}to{opacity:1}}

/* ==========================================================================
   SPLIT SHOWCASE
   ========================================================================== */
.showcase{padding:140px 0;background:linear-gradient(180deg,transparent,rgba(255,255,255,.012),transparent)}
.split{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px;align-items:start}
.project-list{border-top:1px solid var(--line)}
.project-item{
  position:relative;width:100%;display:flex;align-items:center;gap:20px;
  padding:24px 0;border-bottom:1px solid var(--line);text-align:left;
  transition:padding-left .45s var(--ease),color .3s;
  will-change:transform;
}
.project-item::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);transform:scaleY(0);transform-origin:top;transition:transform .45s var(--ease)}
.project-item.active{padding-left:18px}
.project-item.active::before{transform:scaleY(1)}
.project-item__no{font-family:var(--cond);font-size:.72rem;letter-spacing:.18em;color:var(--muted);width:28px}
.project-item.active .project-item__no{color:var(--accent)}
.project-item__txt{flex:1}
.project-item__txt strong{display:block;font-family:var(--display);font-size:clamp(1.7rem,2.6vw,2.5rem);line-height:.95;font-weight:400;letter-spacing:.01em;text-transform:uppercase;color:var(--text)}
.project-item__txt small{display:block;font-family:var(--cond);font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:7px}
.project-item__arrow{font-size:1.2rem;color:var(--muted);transition:color .3s,transform .3s}
.project-item.active .project-item__arrow,.project-item:hover .project-item__arrow{color:var(--accent);transform:translate(3px,-3px)}
.project-specs{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0 48px;max-height:0;opacity:0;overflow:hidden;transition:max-height .5s var(--ease),opacity .4s,margin .4s}
