const fan = { spread:.58, hovered:-1, targetSpread:.58 };
const cursor = { dot:{x:innerWidth/2,y:innerHeight/2}, ring:{x:innerWidth/2,y:innerHeight/2}, aura:{x:innerWidth/2,y:innerHeight/2}, scale:1, targetScale:1 };
const magnetics = $$('[data-magnetic]').map(el=>({el, x:0, y:0, tx:0, ty:0}));
const activePanels = $$('.showcase-panel');
const activeItems  = $$('.project-item');
const activeCounterEls = [];
let activeProject = 0;
let header = $('#siteHeader');

if(!isTouch) document.body.classList.add('custom-cursor');

addEventListener('pointermove', e=>{
  pointer.rawX = e.clientX; pointer.rawY = e.clientY;
  const dx = e.clientX-lastRawX, dy = e.clientY-lastRawY;
  pointerSpeed = lerp(pointerSpeed, Math.min(Math.hypot(dx,dy),90), .25);
  lastRawX = e.clientX; lastRawY = e.clientY;
  pointer.tx = (e.clientX/innerWidth)*2-1;
  pointer.ty = (e.clientY/innerHeight)*2-1;
  $('#panelHalo').style.setProperty('--px', (e.clientX/innerWidth*100)+'%');
  $('#panelHalo').style.setProperty('--py', (e.clientY/innerHeight*100)+'%');
},{passive:true});

/* click ripple */
addEventListener('pointerdown', e=>{
  if(isTouch) return;
  const r = document.createElement('span');
  r.className = 'click-ripple';
  r.style.left = e.clientX+'px'; r.style.top = e.clientY+'px';
  document.body.appendChild(r);
  setTimeout(()=>r.remove(),700);
},{passive:true});

/* cursor growth near interactive elements */
document.addEventListener('pointerover', e=>{
  if(e.target.closest('a,button,[data-cursor-grow],.fan-card')) cursor.targetScale = 1.75;
});
document.addEventListener('pointerout', e=>{
  if(e.target.closest('a,button,[data-cursor-grow],.fan-card')) cursor.targetScale = 1;
});

/* magnetic pull */
magnetics.forEach(m=>{
  m.el.addEventListener('pointermove', e=>{
    const r = m.el.getBoundingClientRect();
    m.tx = (e.clientX-(r.left+r.width/2))*.20;
    m.ty = (e.clientY-(r.top+r.height/2))*.20;
  });
  m.el.addEventListener('pointerleave', ()=>{ m.tx=0; m.ty=0; });
});

/* fan hover */
$$('.fan-card').forEach(card=>{
  card.addEventListener('pointerenter', ()=>{ fan.hovered = +card.dataset.i; fan.targetSpread = 1; });
  card.addEventListener('pointerleave', ()=>{ fan.hovered = -1; fan.targetSpread = .58; });
  card.addEventListener('focus', ()=>{ fan.hovered = +card.dataset.i; fan.targetSpread = 1; });
  card.addEventListener('blur', ()=>{ fan.hovered = -1; fan.targetSpread = .58; });
});

/* showcase switching */
function selectProject(i){
  activeProject = i;
  activeItems.forEach((el,n)=>{
    el.classList.toggle('active',n===i);
    el.setAttribute('aria-selected',String(n===i));
  });
  activePanels.forEach((el,n)=>el.classList.toggle('active',n===i));
  $('#stageCount').textContent = `${PROJECTS[i].no} / 0${PROJECTS.length}`;
  stageProgress.style.width = ((i+1)/PROJECTS.length*100)+'%';
}
selectProject(0);

/* slow auto-advance, paused while the cursor is over the showcase */
let autoTimer = null;
function scheduleAuto(){
  clearInterval(autoTimer);
  if(reduceMotion) return;
  autoTimer = setInterval(()=>selectProject((activeProject+1)%PROJECTS.length),6000);
}
scheduleAuto();
activeItems.forEach(el=>el.addEventListener('click',()=>{ selectProject(+el.dataset.i); scheduleAuto(); }));
$('#showcaseFrame').addEventListener('click',()=>{ selectProject((activeProject+1)%PROJECTS.length); scheduleAuto(); });
$('#showcaseStage').addEventListener('pointerenter',()=>clearInterval(autoTimer));
$('#showcaseStage').addEventListener('pointerleave',scheduleAuto);

/* ===========================================================================
   INTRO — wheel / click zoom transition
   =========================================================================== */
function finishIntro(){
  if(zoom.done) return;
  zoom.done = true;
  document.body.classList.remove('is-locked');
  document.body.classList.add('is-entered');
  const intro = $('#intro');
  intro.style.pointerEvents = 'none';
  setTimeout(()=>intro.remove(), 900);
}
$('#introEnter').addEventListener('click',()=>{ zoom.target = 1; });
addEventListener('wheel', e=>{
  if(zoom.done) return;
  e.preventDefault();
  zoom.target = clamp(zoom.target + Math.abs(e.deltaY)*.0009 + .035, 0, 1);
},{passive:false});
addEventListener('keydown', e=>{
  if(!zoom.done && (e.key==='Enter'||e.key===' '||e.key==='Escape')) zoom.target = 1;
});

/* ===========================================================================
   REVEAL + COUNTER TRIGGERS
   =========================================================================== */
const revealObserver = new IntersectionObserver((entries,obs)=>{
  entries.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('in-view'); obs.unobserve(en.target); } });
},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
$$('.reveal').forEach(el=>revealObserver.observe(el));

const counterObserver = new IntersectionObserver((entries,obs)=>{
  entries.forEach(en=>{
    if(!en.isIntersecting) return;
    const el = en.target;
    el.closest('.counter')?.classList.add('done');
    if(METRICS[activeCounterEls.length]?.static){
      el.textContent = METRICS[activeCounterEls.length].value;
    } else {
      activeCounterEls.push({el, target:+el.dataset.value, start:performance.now(), dur:1500});
    }
    obs.unobserve(el);
  });
},{threshold:.6});
$$('.counter__value span').forEach(el=>counterObserver.observe(el));

/* header state + nav highlight */
addEventListener('scroll',()=>{
  header.classList.toggle('scrolled',scrollY>30);
  const max = document.documentElement.scrollHeight - innerHeight;
  scrollProgress.style.width = (max>0 ? (scrollY/max*100) : 0)+'%';
},{passive:true});
const navLinks = $$('#nav a');
const sectionIds = ['top','work','studio','contact'];
const navObserver = new IntersectionObserver(entries=>{
  entries.forEach(en=>{
    if(en.isIntersecting) navLinks.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+en.target.id));
  });
},{threshold:.25,rootMargin:'-15% 0px -65% 0px'});
sectionIds.forEach(id=>{ const s=document.getElementById(id); if(s) navObserver.observe(s); });

/* mobile menu */
const menuToggle = $('#menuToggle'), nav = $('#nav');
menuToggle.addEventListener('click',()=>{
  const open = nav.classList.toggle('open');
  menuToggle.classList.toggle('open',open);
  menuToggle.setAttribute('aria-expanded',String(open));
});
navLinks.forEach(a=>a.addEventListener('click',()=>{
  nav.classList.remove('open'); menuToggle.classList.remove('open'); menuToggle.setAttribute('aria-expanded','false');
}));

/* ===========================================================================
   SINGLE rAF LOOP — all motion uses damped lerp for smooth inertia
   =========================================================================== */
const introPlanes = $$('.intro-plane');
const heroLayers  = $$('[data-hero-depth]');
const fanCards    = $$('.fan-card');

function tick(now){
  /* damped pointer */
  pointer.x = lerp(pointer.x, pointer.tx, .075);
  pointer.y = lerp(pointer.y, pointer.ty, .075);

  /* --- intro planes: tilt + parallax OPPOSITE the cursor --- */
  if(!zoom.done){
    introPlanes.forEach(plane=>{
      const d = +plane.dataset.depth;
      const tx = -pointer.x*d*46, ty = -pointer.y*d*34;
      const ry = -pointer.x*d*9,  rx = pointer.y*d*9;
      plane.style.transform = `translate3d(${tx}px,${ty}px,0) rotateY(${ry}deg) rotateX(${rx}deg)`;
    });
  }

  /* --- zoom progression --- */
  zoom.current = lerp(zoom.current, zoom.target, .075);
  document.documentElement.style.setProperty('--intro-scale', 1+zoom.current*5.5);
  document.documentElement.style.setProperty('--intro-alpha', 1-clamp(zoom.current*1.25,0,1));
  document.documentElement.style.setProperty('--main-scale', 1.10-zoom.current*.10);
  document.documentElement.style.setProperty('--main-alpha', clamp(zoom.current*1.3,0,1));
  document.documentElement.style.setProperty('--main-blur', (6*(1-zoom.current)).toFixed(2)+'px');
  if(zoom.current>.985 && !zoom.done) finishIntro();

  /* --- custom cursor (three lag layers) --- */
  if(!isTouch){
    cursor.dot.x  = lerp(cursor.dot.x,  pointer.rawX, .28);
    cursor.dot.y  = lerp(cursor.dot.y,  pointer.rawY, .28);
    cursor.ring.x = lerp(cursor.ring.x, pointer.rawX, .13);
    cursor.ring.y = lerp(cursor.ring.y, pointer.rawY, .13);
    cursor.aura.x = lerp(cursor.aura.x, pointer.rawX, .075);
    cursor.aura.y = lerp(cursor.aura.y, pointer.rawY, .075);
    cursor.scale  = lerp(cursor.scale, cursor.targetScale, .12);
    $('#cursorDot').style.transform  = `translate3d(${cursor.dot.x}px,${cursor.dot.y}px,0) translate(-50%,-50%)`;
    $('#cursorRing').style.transform = `translate3d(${cursor.ring.x}px,${cursor.ring.y}px,0) translate(-50%,-50%) scale(${cursor.scale}) rotate(${(now*.014)%360}deg)`;
    $('#cursorAura').style.transform = `translate3d(${cursor.aura.x}px,${cursor.aura.y}px,0) translate(-50%,-50%) scale(${(.9+cursor.scale*.35).toFixed(3)})`;
  }

  /* --- magnetic UI --- */
  magnetics.forEach(m=>{
    m.x = lerp(m.x,m.tx,.14); m.y = lerp(m.y,m.ty,.14);
    m.el.style.transform = `translate3d(${m.x.toFixed(2)}px,${m.y.toFixed(2)}px,0)`;
  });

  /* --- marquee speed reacts to cursor velocity --- */
  marqueeTrack.style.animationDuration = (26 - Math.min(pointerSpeed*.14,14)).toFixed(2)+'s';

  /* --- hero layer parallax --- */
  heroLayers.forEach(layer=>{
    const d = +layer.dataset.heroDepth;
    layer.style.transform = `translate3d(${(pointer.x*d*34).toFixed(2)}px,${(pointer.y*d*26).toFixed(2)}px,0) rotateY(${(pointer.x*d*3).toFixed(2)}deg) rotateX(${(-pointer.y*d*2.5).toFixed(2)}deg)`;
  });

  /* --- fanned stack: spread + per-card depth tilt --- */
  fan.spread = lerp(fan.spread, fan.targetSpread, .07);
  const compact = innerWidth < 760;
  /* cards fly in as the intro zoom resolves, then breathe gently forever */
  const entrance = clamp((zoom.current-.55)/.45,0,1);
  fanCards.forEach((card,i)=>{
    const off = i-(fanCards.length-1)/2;
    const depth = 1-Math.abs(off)/fanCards.length;
    const spreadX = (compact?32:58)*fan.spread;
    const idle = reduceMotion ? 0 : Math.sin(now*.0012+i*1.15)*4;
    const x = off*spreadX*(1+(1-entrance)*1.4) + pointer.x*13*depth;
    const y = Math.abs(off)*11*fan.spread + pointer.y*9*depth - (fan.hovered===i?34:0) + (1-entrance)*260 + idle;
    const z = -Math.abs(off)*48 - (1-entrance)*320 + (fan.hovered===i?90:0);
    const rz = off*9*fan.spread*(1+(1-entrance)*1.8) + (fan.hovered===i?-off*2:0);
    const ry = -pointer.x*7*depth + (fan.hovered===i?pointer.x*10:0);
    const rx = pointer.y*5*depth + (fan.hovered===i?-pointer.y*8:0);
    card.style.transform = `translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,${z.toFixed(2)}px) rotateZ(${rz.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) rotateX(${rx.toFixed(2)}deg)`;
  });

  /* --- showcase parallax + frame tilt --- */
  const activeArt = activePanels[activeProject]?.querySelector('.panel-art');
  if(activeArt) activeArt.style.transform = `translate3d(${(-pointer.x*18).toFixed(2)}px,${(-pointer.y*13).toFixed(2)}px,0) scale(1.08)`;
  $('#showcaseStage').style.transform = `rotateY(${(pointer.x*2.4).toFixed(2)}deg) rotateX(${(-pointer.y*1.8).toFixed(2)}deg)`;

  /* --- counters --- */
  activeCounterEls.forEach(c=>{
    const p = clamp((now-c.start)/c.dur,0,1);
    const eased = 1-Math.pow(1-p,4);
    c.el.textContent = Math.round(c.target*eased);
  });

  requestAnimationFrame(tick);
}

/* Reduced motion: skip the cinematic intro motion entirely */
if(reduceMotion){
  zoom.target = 1; zoom.current = 1; zoom.done = true;
  document.body.classList.remove('is-locked');
  document.body.classList.add('is-entered');
  $('#intro')?.remove();
  activeCounterEls.length = 0;
  $$('.counter__value span').forEach((el,i)=>{ el.textContent = METRICS[i].value; });
}
requestAnimationFrame(tick);
</script>
</body>
</html>
